# Deployment environment template for the single perfcho Compose stack.
# then replace every `replace-with-*` value before deploying:
#   openssl rand -hex 32
#   docker compose --env-file .env up -d --build
#
# Every variable below is the deployment-time value for the compose.yaml stack.

# PostgreSQL, Redis, MinIO, and signing secrets.
# Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-random-hex-secret
REDIS_PASSWORD=replace-with-a-random-hex-secret
PASSWORD_PEPPER=replace-with-an-independent-random-hex-secret
TOKEN_HMAC_KEY=replace-with-an-independent-random-hex-secret
DEVICE_HMAC_KEY=replace-with-an-independent-random-hex-secret
MATCH_PASSWORD_HMAC_KEY=replace-with-an-independent-random-hex-secret
ADMISSION_HMAC_KEY=replace-with-an-independent-random-hex-secret

# MinIO object storage credentials. The Compose service is internal-only.
MINIO_ROOT_USER=replace-with-a-minio-access-key
MINIO_ROOT_PASSWORD=replace-with-a-random-minio-password
S3_REGION=us-east-1
S3_BUCKET=perfcho
S3_ADDRESSING_STYLE=path

# Official osu! API client credentials for content synchronization workers
OSU_API_CLIENT_ID=replace-with-an-osu-api-client-id
OSU_API_CLIENT_SECRET=replace-with-an-osu-api-client-secret

# Formula calculator code to internal HTTP endpoint map.
PERFORMANCE_CALCULATOR_URLS={"perfcho-pp":"http://calculator-dotnet:6001"}

# The API is intended to sit behind a reverse proxy on the same host.
APP_BIND_ADDRESS=127.0.0.1
APP_PUBLISHED_PORT=10727
CORS_ORIGINS=["https://osu.example.com"]
TRUSTED_PROXY_CIDRS=[]
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_HTTP_SUCCESS_SAMPLE_RATE=0.05
LOG_STABLE_POLL_SAMPLE_RATE=0.01
LOG_HOT_PATH_SAMPLE_RATE=0.001
LOG_SLOW_REQUEST_MS=1000

# Keep aggregate pools below PostgreSQL max_connections across all processes.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
TASKIQ_WORKERS=2
RANK_SNAPSHOT_POLL_INTERVAL_SECONDS=60
STABLE_SESSION_STALE_GRACE_SECONDS=120
BOT_ACCOUNT_ID=1
BOT_NAME=BanchoBot
BOT_COMMAND_PREFIX=!

# Public resource forwarding. These assets are not persisted in perfcho object storage.
STABLE_AVATAR_BASE_URL=https://a.ppy.sh
STABLE_BEATMAP_ASSET_BASE_URL=https://b.ppy.sh
STABLE_SEASONAL_URL=https://osu.ppy.sh/web/osu-getseasonal.php
STABLE_MENU_CONTENT_URL=https://assets.ppy.sh/menu-content.json

# Override when the image is built and published by CI.
PERFCHO_IMAGE=perfcho:latest
