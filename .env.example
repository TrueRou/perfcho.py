# Application configuration
APP_HOST=127.0.0.1
APP_PORT=10727
APP_DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=human
LOG_HTTP_SUCCESS_SAMPLE_RATE=0.05
LOG_STABLE_POLL_SAMPLE_RATE=0.01
LOG_HOT_PATH_SAMPLE_RATE=0.001
LOG_SLOW_REQUEST_MS=1000

# CORS (allowed origins list, JSON format)
# CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# PostgreSQL (matches the development Compose service)
DATABASE_URL=postgresql+asyncpg://perfcho:perfcho@127.0.0.1:55432/perfcho
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30
PASSWORD_PEPPER=perfcho-development-password-pepper
PASSWORD_PEPPER_VERSION=1
TOKEN_HMAC_KEY=perfcho-development-token-hmac-key
DEVICE_HMAC_KEY=perfcho-development-device-hmac-key
MATCH_PASSWORD_HMAC_KEY=perfcho-development-match-password-hmac-key
ADMISSION_HMAC_KEY=perfcho-development-admission-hmac-key

# One Redis instance, isolated by logical database and key namespace
REDIS_STATE_URL=redis://127.0.0.1:56379/0
REDIS_STATE_PREFIX=perfcho:state
REDIS_SOCKET_TIMEOUT=5
REDIS_PRESENCE_TTL_SECONDS=360
REDIS_MAILBOX_TTL_SECONDS=600
REDIS_MAILBOX_MAX_PACKETS=4096
REDIS_REALTIME_MAX_CHANNELS_PER_SESSION=256
REDIS_SPECTATOR_MAX_VIEWERS=4096
REDIS_MULTIPLAYER_TTL_SECONDS=43200
REDIS_MULTIPLAYER_MAX_ROOMS=4096
TASKIQ_BROKER_URL=redis://127.0.0.1:56379/1
TASKIQ_QUEUE_NAME=perfcho:tasks
TASKIQ_CONSUMER_GROUP=perfcho:workers
TASKIQ_STREAM_MAX_LENGTH=100000

# Durable relay and transactional outbox delivery
DURABLE_RELAY_POLL_INTERVAL_SECONDS=1
OUTBOX_DELIVERY_BATCH_SIZE=100
OUTBOX_DELIVERY_LEASE_SECONDS=300
OUTBOX_DELIVERY_MAX_ATTEMPTS=10
OUTBOX_DELIVERY_MAX_RETRY_SECONDS=300

# External multi-formula calculators (JSON map keyed by Formula calculator code)
# PERFORMANCE_CALCULATOR_URLS={"osu-lazer-dotnet":"http://127.0.0.1:6001","perfcho-rust":"http://127.0.0.1:6002"}
PERFORMANCE_HTTP_TIMEOUT_SECONDS=30
PERFORMANCE_BEATMAP_URL_EXPIRY_SECONDS=600
PERFORMANCE_CALCULATION_BATCH_SIZE=32
PERFORMANCE_CALCULATION_LEASE_SECONDS=300
PERFORMANCE_CALCULATION_MAX_ATTEMPTS=5
PERFORMANCE_CALCULATION_MAX_RETRY_SECONDS=300

# S3-compatible object storage (matches the development MinIO service)
S3_ENDPOINT_URL=http://127.0.0.1:59000
# Optional URL visible from external Calculator containers; defaults to S3_ENDPOINT_URL.
# S3_PRESIGN_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=perfcho
S3_SECRET_KEY=perfcho-development
S3_BUCKET=perfcho
S3_ADDRESSING_STYLE=path
OBJECT_STREAM_CHUNK_SIZE=1048576

# Official osu! API client credentials used by content synchronization workers
OSU_API_CLIENT_ID=0
OSU_API_CLIENT_SECRET=

# Stable adapter response bounds
TRUSTED_PROXY_CIDRS=[]
STABLE_SESSION_STALE_GRACE_SECONDS=120
STABLE_LOBBY_MATCH_LIMIT=100
STABLE_PRESENCE_BATCH_SIZE=2048
