{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "dev: sync dependencies",
            "type": "process",
            "command": "uv",
            "args": [
                "sync",
                "--locked"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "dev: ensure .env",
            "type": "shell",
            "command": "test -f .env || cp .env.example .env",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "dev: start infrastructure",
            "type": "process",
            "command": "docker",
            "args": [
                "compose",
                "up",
                "-d"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "dev: prepare",
            "dependsOn": [
                "dev: sync dependencies",
                "dev: ensure .env",
            ],
            "dependsOrder": "parallel",
            "problemMatcher": []
        }
    ]
}
